# Copy to .env and fill in. Never commit .env.

# SQL Server "sa" password. Policy: at least 8 characters, from three of upper
# case, lower case, digits and symbols. Avoid ; $ and quotes: they break the
# connection string or docker-compose variable substitution.
MSSQL_SA_PASSWORD=

# Signs the login tokens (JWT). At least 32 characters: generate one with
# openssl rand -base64 32
JWT_KEY=

# IGDB credentials from https://dev.twitch.tv/console/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
